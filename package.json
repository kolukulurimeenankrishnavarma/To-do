{
  "name": "to-do-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "server": "node server/index.mjs",
    "prestart": "node scripts/check-node.mjs",
    "start": "node server/index.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/check-node.mjs",
    "test:e2e": "playwright test",
    "mail:test": "node server/mail-test.mjs",
    "pretypecheck": "node scripts/check-node.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
