# Copy this file to .env and uncomment/fill in what you need.
# Never commit .env — it is ignored by Git.

# Public base URL used in invitation and password-reset links.
# Set this to the address teammates use in the browser, without a trailing /.
TASKLY_PUBLIC_URL=http://127.0.0.1:8787

# Option A — a single SMTP URL (credentials must be URL-encoded, e.g. @ -> %40).
# TASKLY_SMTP_URL=smtps://user:pass%40word@smtp.example.com:465

# Option B — individual settings (used only when TASKLY_SMTP_URL is unset).
# TASKLY_SMTP_HOST=smtp.example.com
# TASKLY_SMTP_PORT=587
# Use 1 only for implicit TLS on port 465. Otherwise Taskly uses STARTTLS when offered.
# TASKLY_SMTP_SECURE=0
# Set to 0 only for a local relay that must stay unencrypted.
# TASKLY_SMTP_STARTTLS=1
# TASKLY_SMTP_USER=your-smtp-username
# TASKLY_SMTP_PASS=your-smtp-password-or-app-password
# Can be a bare address or a display name: "Taskly <no-reply@example.com>"
# TASKLY_SMTP_FROM=Taskly <no-reply@example.com>

# Common providers (double-check ports and auth rules with your provider):
# Gmail:        smtp.gmail.com:587, STARTTLS, username = full email, app password
# Outlook/365:  smtp.office365.com:587, STARTTLS, username = full email
# SendGrid:     smtp.sendgrid.net:587, username = apikey, password = API key
# Resend:       smtp.resend.com:587, username = resend, password = API key
# Brevo:        smtp-relay.brevo.com:587, username = SMTP login, password = SMTP key
# Mailgun:      smtp.mailgun.org:587, username = full SMTP user, password = SMTP password

# After saving, verify delivery with:
# npm run mail:test -- --to you@example.com
